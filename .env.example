# Ключ Polza AI (обязателен для серверной части)
POLZA_API_KEY=ВСТАВЬТЕ_СВОЙ_КЛЮЧ_POLZA

# Ключи фотостоков (необязательно, но фото подбираются заметно точнее)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Модели по умолчанию
DEFAULT_TEXT_MODEL=anthropic/claude-sonnet-4.5
DEFAULT_REFINE_MODEL=anthropic/claude-haiku-4.5
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image

# Разрешить посетителям подставлять свой ключ (X-Polza-Key)
ALLOW_OWN_KEY=1
